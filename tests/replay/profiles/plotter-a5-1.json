{
 "version": "1.0",
 "name": "plotter-a5",
 "frame": "paper",
 "area_mm": [
  8.0,
  8.0,
  194.0,
  132.0
 ],
 "view": "page",
 "viewer": {
  "right": [
   1.0,
   0.0
  ],
  "away": [
   0.0,
   1.0
  ]
 },
 "pointer": {
  "source": "finger",
  "filter": {
   "min_cutoff": 1.0,
   "beta": 0.02,
   "d_cutoff": 1.0
  },
  "hold": {
   "speed_enter_mm_s": 20.0,
   "speed_exit_mm_s": 30.0,
   "min_duration_s": 0.15,
   "speed_window_s": 0.1,
   "max_gap_s": 0.12,
   "require_pointing": true,
   "history_s": 120.0
  },
  "base_sigma_mm": 1.5,
  "max_spread_mm": 6.0,
  "same_place_mm": 10.0
 },
 "spans": {
  "max_rate_mm_s": 25.0,
  "window_s": 0.1,
  "min_duration_s": 0.2,
  "min_span_mm": 8.0,
  "max_gap_s": 0.12,
  "history_s": 30.0
 },
 "timing": {
  "before_s": 1.5,
  "after_s": 0.5,
  "no_word_before_s": 2.0,
  "time_sigma_s": 0.6,
  "ambiguity_ratio": 2.0,
  "size_overlap": 0.5
 },
 "sizes": {
  "default_mm": 40.0,
  "presets": {
   "tiny": 20.0,
   "small": 35.0,
   "medium": 55.0,
   "big": 80.0,
   "whole_page": null
  },
  "synonyms": {
   "large": "big",
   "huge": "big",
   "giant": "big",
   "little": "small",
   "mini": "tiny",
   "normal": "medium",
   "regular": "medium",
   "full_page": "whole_page",
   "page": "whole_page",
   "whole page": "whole_page",
   "the whole page": "whole_page"
  },
  "min_mm": 5.0,
  "max_mm": 200.0
 },
 "scene": {
  "near_mm": 20.0,
  "ambiguous_mm": 6.0,
  "gap_mm": 10.0,
  "inside_fill": 0.7,
  "empty_margin_mm": 3.0,
  "grid_mm": 1.0,
  "label_ties": "most_recent"
 },
 "adjust": {
  "step_mm": 5.0
 },
 "outside": "keep",
 "asks": {
  "no_gesture": "Where do you mean? Point at the paper.",
  "no_gesture.pointed": "Where should it go? Point at the paper.",
  "no_object": "I don't see anything there. Which one do you mean?",
  "no_object.empty": "There's nothing drawn yet. What do you mean?",
  "unknown_label": "I don't see a {label}. Which one do you mean?",
  "ambiguous_object": "The {options}?",
  "no_room": "The sheet is full. Shall I start a new page?",
  "no_previous": "There's nothing to adjust right now."
 },
 "words": {
  "demonstratives": [
   "here",
   "there",
   "this",
   "that",
   "these",
   "those",
   "so"
  ]
 },
 "actions": [
  {
   "name": "place_drawing",
   "description": "Draw one object from the drawable list at a place, at a size. Call once per object.",
   "params": [
    {
     "name": "object",
     "type": "text",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": true,
     "choices": [],
     "description": "A drawable category, e.g. 'tree'."
    },
    {
     "name": "place",
     "type": "place",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": false,
     "choices": [],
     "description": "Omit if no place was spoken: the last pointing is used."
    },
    {
     "name": "size",
     "type": "size",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": false,
     "choices": [],
     "description": "Omit if no size was spoken."
    },
    {
     "name": "style",
     "type": "choice",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": false,
     "choices": [
      "simple",
      "detailed"
     ],
     "description": "Only if the person asked for a simple or a detailed drawing."
    }
   ],
   "agent": true
  },
  {
   "name": "draw_connector",
   "description": "Draw an arrow or line from one object or pointed spot to another.",
   "params": [
    {
     "name": "kind",
     "type": "choice",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": false,
     "choices": [
      "arrow",
      "line",
      "double_arrow"
     ],
     "description": ""
    },
    {
     "name": "from",
     "type": "object",
     "want": "point",
     "size_from": null,
     "allow_point": true,
     "required": true,
     "choices": [],
     "description": ""
    },
    {
     "name": "to",
     "type": "object",
     "want": "point",
     "size_from": null,
     "allow_point": true,
     "required": true,
     "choices": [],
     "description": ""
    }
   ],
   "agent": true
  },
  {
   "name": "write_label",
   "description": "Write text on the sheet. Copy the user's words for the text verbatim.",
   "params": [
    {
     "name": "text",
     "type": "text",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": true,
     "choices": [],
     "description": "The words to write, copied verbatim."
    },
    {
     "name": "place",
     "type": "place",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": false,
     "choices": [],
     "description": ""
    },
    {
     "name": "size",
     "type": "size",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": false,
     "choices": [],
     "description": ""
    }
   ],
   "agent": true
  },
  {
   "name": "look",
   "description": "Ask the camera/vision model a question about the sheet (what is drawn, where).",
   "params": [
    {
     "name": "query",
     "type": "text",
     "want": "point",
     "size_from": null,
     "allow_point": false,
     "required": true,
     "choices": [],
     "description": ""
    }
   ],
   "agent": true
  },
  {
   "name": "new_sheet",
   "description": "The user wants a fresh sheet of paper; clears the scene.",
   "params": [],
   "agent": true
  }
 ]
}
