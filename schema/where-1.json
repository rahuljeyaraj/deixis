{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rahuljeyaraj/deixis/blob/main/schema/where-1.json",
  "description": "A place in the robot's frame: a point, a box or a path.",
  "properties": {
    "version": {
      "default": "1.0",
      "description": "Schema version, 1.x.",
      "title": "Version",
      "type": "string"
    },
    "frame": {
      "description": "The profile's frame; every coordinate is in it.",
      "title": "Frame",
      "type": "string"
    },
    "kind": {
      "enum": [
        "point",
        "box",
        "path"
      ],
      "title": "Kind",
      "type": "string"
    },
    "mean_mm": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The point, or the centre of a box, or the mean of a path's points. Always set in output; filled in for boxes and paths.",
      "title": "Mean Mm"
    },
    "box_mm": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "x, y, w, h with (x, y) the minimum corner.",
      "title": "Box Mm"
    },
    "path_mm": {
      "anyOf": [
        {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Two or more points.",
      "title": "Path Mm"
    },
    "z_mm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Height above the frame's surface, when known ('on that').",
      "title": "Z Mm"
    },
    "cov_mm2": {
      "default": [
        [
          0.0,
          0.0
        ],
        [
          0.0,
          0.0
        ]
      ],
      "description": "Uncertainty of mean_mm, mm^2.",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        }
      ],
      "title": "Cov Mm2",
      "type": "array"
    },
    "thing": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The thing's id, for an object.",
      "title": "Thing"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The thing's label, for an object.",
      "title": "Label"
    },
    "source": {
      "enum": [
        "gesture",
        "gesture+vlm",
        "vlm",
        "verbal_preset",
        "object_ref",
        "geometry",
        "default",
        "adjust"
      ],
      "title": "Source",
      "type": "string"
    },
    "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "additionalProperties": true,
      "description": "How it was found, e.g. {\"rule\": \"nearest\", \"word\": \"here\", \"hold_t\": [11.9, 12.2]}.",
      "title": "Evidence",
      "type": "object"
    }
  },
  "required": [
    "frame",
    "kind",
    "source"
  ],
  "title": "Where",
  "type": "object"
}
